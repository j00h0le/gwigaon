<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pleos Vehicle SDK read permissions (protectionLevel normal on Pleos Connect). -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />

    <!-- Pleos NaviHelper SDK: route search/cancel and route/destination queries. -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />

    <!-- Pleos TextToSpeech SDK (arrival instructions read aloud). -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <!-- Trip location for route monitoring and SOS. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Trip monitoring keeps running in the background as a location foreground service (T8). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Conflict cues (SPEC conflict-cues, ADR 0012): on-device loudness, asked for only when the passenger turns
         the switch on; the trip service then also holds the microphone type. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Stage 2: Pleos SpeechToText on the device, fed our own audio (it never opens the mic). -->
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <!-- The ongoing trip-status notification (Android 13+ asks the user). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Cloud sync and the contact page link. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Upload the queue as soon as the network comes back (normal permission, no prompt). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Lets the share card see whether the car has a share target (package visibility, Android 11+). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:name=".GwigaonApp"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gwigaon">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true">
            <!-- AAOS: without this the platform blocks the activity while driving (seen in the T3 spike). -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".trip.TripService"
            android:exported="false"
            android:foregroundServiceType="location|microphone" />
    </application>

</manifest>
